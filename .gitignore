# =============================================================================
# SecureLoRA — .gitignore
# =============================================================================

# ── Secrets & Credentials ─────────────────────────────────────────────────────
.env
*.key
secrets.key
real_data.key
*.pem                          # Never commit private keys

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml
*.egg-info/
dist/
build/

# ── Virtual Environment ────────────────────────────────────────────────────────
venv/
.venv/
env/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
notebook_checkpoints/

# ── Logs ───────────────────────────────────────────────────────────────────────
logs/
*.log

# ── Encrypted Dataset Artefacts (PII — never commit) ──────────────────────────
*.enc
*.jsonl
real_data_inputs/
encrypted_real_data/

# ── Training Artefacts ─────────────────────────────────────────────────────────
checkpoints/
lora_adapters/
eval_report.json               # root-level legacy copy

# ── Runtime Job Workspace (per-job secrets + ephemeral files) ─────────────────
outputs/jobs/
raw_inputs/
raw_shred/

# ── Phase 3 / 4 Protected Adapter Outputs (contain keys / ciphertext) ─────────
outputs/protected_adapter/adapter.enc
outputs/protected_adapter/adapter.hash
outputs/protected_adapter/adapter.sig
outputs/protected_adapter/metadata.json
outputs/protected_adapter/package_manifest.json
outputs/protected_adapter/dev_private.pem
outputs/protected_adapter/public.pem
outputs/protected_adapter.tar.gz

# ── Final Adapter Weights (large binary, managed separately) ──────────────────
outputs/final_adapter/

# ── Test Environment I/O ──────────────────────────────────────────────────────
test_env_inputs/
test_env_outputs/
decrypted_outputs/
encrypted_outputs/
shred_outputs/

# ── IDE & OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
