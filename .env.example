# =============================================================================
# SecureLoRA — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATASET ENCRYPTION KEY  (Phase 1 & 2)
# -----------------------------------------------------------------------------
# The AES-256 key used to encrypt/decrypt training datasets.
# Provide EITHER a hex key OR a key file path (hex takes precedence).

# Option A — Hex-encoded 32-byte key (64 hex characters):
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECURE_LORA_KEY_HEX=

# Option B — Path to a binary key file on disk:
SECURE_LORA_KEY_PATH=secrets.key

# -----------------------------------------------------------------------------
# DATASET PIPELINE DEFAULTS  (Phase 1)
# -----------------------------------------------------------------------------
SECURE_LORA_INPUT_DIR=real_data_inputs
SECURE_LORA_OUTPUT_DIR=encrypted_real_data
SECURE_LORA_DATASET_NAME=SecureLoRADataset
SECURE_LORA_DATASET_VERSION=1.0.0

# -----------------------------------------------------------------------------
# PHASE 3 — HARDWARE BINDING & ADAPTER ENCRYPTION
# -----------------------------------------------------------------------------
# REQUIRED: Secret salt for HKDF device-bound key derivation.
#   Generate: python -c "import secrets; print(secrets.token_hex(32))"
#   This + the hardware fingerprint together derive the AES key.
#   Rotate this value per deployment environment.
P3_DEVICE_SALT=

# Adapter input / output directories
P3_ADAPTER_INPUT_DIR=outputs/final_adapter
P3_PROTECTED_OUTPUT_DIR=outputs/protected_adapter

# RSA keypair settings (for signing the encrypted package)
P3_RSA_KEY_BITS=2048
P3_RSA_PRIVATE_KEY_PATH=outputs/protected_adapter/dev_private.pem
P3_RSA_PUBLIC_KEY_PATH=outputs/protected_adapter/public.pem

# Package metadata
P3_ADAPTER_ID=lora-adapter-v1
P3_MODEL_REFERENCE=JackFram/llama-68m

# -----------------------------------------------------------------------------
# PHASE 2 — TRAINING  (optional overrides)
# -----------------------------------------------------------------------------
# Custom inference prompt used to test the model after training
SECURE_LORA_SAMPLE_PROMPT=Mask all Personally Identifiable Information (PII) in the text.

# Path to write real-time training progress JSON (used by dashboard)
SECURE_LORA_PROGRESS_FILE=outputs/progress.json

# -----------------------------------------------------------------------------
# DASHBOARD  (src/evaluation/dashboard.py)
# -----------------------------------------------------------------------------
DASHBOARD_PORT=5001
DASHBOARD_DEBUG=false
